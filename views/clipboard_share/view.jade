extends ../layout

block content
  main.clipboard-card
    h1 View text
    if saved
      p.notice.success Saved content successfully.
    if error
      p.notice.error= error
    if data !== null
      label(for='shared-data') Content
      textarea#shared-data(rows='35', readonly)= data
    else
      form(method='post', action='/cb/view')
        label(for='password') Unlock password
        input#password.unlock-password(type='password', name='password', required, autofocus, autocomplete='current-password')
        button(type='submit') Open
    p
      a(href='/cb') Back
